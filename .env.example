# RecoverAI Environment Configuration Example
RECOVERY_MODE=simulation
LLM_PROVIDER=huggingface
LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
LLM_ADAPTER_PATH=backend/llm/models/recoverai-lora
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Provider (SMTP)
# Set EMAIL_PROVIDER=smtp to enable real email sending
# Leave unset or set to "simulated" to use simulation mode
EMAIL_PROVIDER=simulated
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=RecoverAI <your_email@gmail.com>
# EMAIL_TEST_RECIPIENT: when set, all emails go to this address (demo/test mode safety)
EMAIL_TEST_RECIPIENT=

# SMS Provider (future integration)
SMS_PROVIDER=simulated

# WhatsApp Provider (future integration)
WHATSAPP_PROVIDER=simulated

# Voice Provider (future integration)
VOICE_PROVIDER=simulated
